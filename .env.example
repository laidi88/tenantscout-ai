# Copy this file to .env and fill in the value. Never commit .env.
#
# Railway PostgreSQL connection string. For local development, use a separate
# Railway development database (Railway → your Postgres service → Connect →
# "Public Network" URL), never the production database.
# Leave it unset to run the app in Demo Mode with in-memory sample data.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/railway"

# Optional. Set to "false" to stop the deploy step from loading demo data
# into an empty database.
# SEED_DEMO_DATA="false"
